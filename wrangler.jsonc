{
  // Shape Chicago (branch shape-v1): static pages + a small API (worker/index.js).
  // Its own Worker, separate from fix-chicago-housing (which keeps serving fixchicagohousing.com until launch).
  // Preview at the workers.dev address; at launch, attach the new domain here and point fixchicagohousing.com at it.
  "name": "shape-chicago",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "COMMUNITY", "class_name": "Community" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Community"] }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
