{
  // Shape Chicago (branch shape-v1): static pages + a small API (worker/index.js).
  // Its own Worker, separate from fix-chicago-housing (which keeps serving fixchicagohousing.com until launch).
  // Preview at the workers.dev address; at launch, attach the new domain here and point fixchicagohousing.com at it.
  "name": "shape-chicago",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "COMMUNITY", "class_name": "Community" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Community"] }],
  // the old site's Worker, to copy plans people posted there into this gallery until launch (worker/index.js sync())
  "services": [{ "binding": "OLD", "service": "fix-chicago-housing" }],
  "workers_dev": true,
  // keep variables set in the Cloudflare dashboard when this file deploys (FEEDBACK_KEY should be a Secret, which is kept anyway)
  "keep_vars": true,
  // To email feedback to hello@shapechicago.city: onboard the domain in Cloudflare Email Service, then add
  //   "send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["hello@shapechicago.city"] }],
  "observability": { "enabled": true }
}
